#!/bin/bash
# Runs once on first boot via cloud-init, as root.
set -euxo pipefail

# Wait for general internet
until curl -s --max-time 5 https://get.k3s.io >/dev/null; do
  echo "[agent] waiting for network..."
  sleep 2
done

# Install k3s agent and join the server. The server's k3s API server might
# not be up yet — k3s's installer/service handles retries automatically.
curl -sfL https://get.k3s.io | \
  K3S_URL=https://${server_ip}:6443 \
  K3S_TOKEN='${k3s_token}' \
  sh -

echo "[agent] k3s agent install complete; will retry join until server is ready"
